    "plt.figure(figsize=(10, 6))\n",
    "plt.title(\"RFECV: Finding the Sweet Spot\", fontsize=16)\n",
    "plt.xlabel(\"Number of Features Selected\", fontsize=12)\n",
    "plt.ylabel(\"Cross-Validation Score (Higher is Better)\", fontsize=12)\n",
    "\n",
